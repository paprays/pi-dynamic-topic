  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "topic",
    "dynamic-topic",
    "herdr",
    "terminal-title"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "index.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
